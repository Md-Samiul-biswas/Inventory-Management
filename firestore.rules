rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(productId);
    }

    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(orderId);
    }

    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(expenseId);
    }

    match /packages/{packageId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(packageId);
    }

    match /notes/{noteId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(noteId);
    }
  }
}
